    {
      "parameters": {
        "jsCode": "const rows = $input.all()\n  .map(i => i.json)\n  .filter(r => Object.keys(r).some(k => k !== 'row_number' && String(r[k] ?? '').trim() !== ''));\n\nif (rows.length === 0) {\n  return [{ json: { hasData: false, subject: '', body: '' } }];\n}\n\nconst esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cols = Object.keys(rows[0]).filter(k => k !== 'row_number');\nconst th = 'border:1px solid #ddd;padding:8px;background:#f3f3f3;text-align:left';\nconst td = 'border:1px solid #ddd;padding:8px';\n\nlet html = '<p>Hi,</p>';\nhtml += '<p>Here is the latest data from the sheet (' + rows.length + (rows.length === 1 ? ' record' : ' records') + '):</p>';\nhtml += '<table style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px\">';\nhtml += '<tr>' + cols.map(c => '<th style=\"' + th + '\">' + esc(c) + '</th>').join('') + '</tr>';\nrows.forEach(r => {\n  html += '<tr>' + cols.map(c => '<td style=\"' + td + '\">' + esc(r[c]) + '</td>').join('') + '</tr>';\n});\nhtml += '</table>';\nhtml += '<p>Regards,<br>Your Automation Bot</p>';\n\nreturn [{ json: { hasData: true, count: rows.length, subject: 'Data Summary from Google Sheet (' + rows.length + (rows.length === 1 ? ' record)' : ' records)'), body: html } }];"
      },
